
<svg xmlns="http://www.w3.org/2000/svg"
     width="192" height="192"
     viewBox="0 0 512 512">

  <defs>
    <linearGradient id="background" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#080F24"/>
      <stop offset="100%" stop-color="#172B55"/>
    </linearGradient>

    <linearGradient id="book" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#BBDDFE"/>
    </linearGradient>

    <linearGradient id="code" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#38D9FF"/>
      <stop offset="100%" stop-color="#6575FF"/>
    </linearGradient>
  </defs>

  <rect width="512" height="512" rx="112" fill="url(#background)"/>

  <circle cx="420" cy="95" r="75" fill="#38D9FF" opacity=".07"/>
  <circle cx="90" cy="420" r="90" fill="#6575FF" opacity=".07"/>

  <!-- Open Book -->
  <path d="M256 190
           C210 155 145 150 95 175
           V350
           C155 325 210 335 256 375
           C302 335 357 325 417 350
           V175
           C367 150 302 155 256 190Z"
        fill="url(#book)"/>

  <!-- Book Center -->
  <path d="M256 190 V375"
        stroke="#8296B5" stroke-width="9"
        stroke-linecap="round"/>

  <!-- Left Code Symbol -->
  <path d="M190 235 L155 270 L190 305"
        fill="none" stroke="url(#code)"
        stroke-width="17" stroke-linecap="round"
        stroke-linejoin="round"/>

  <!-- Right Code Symbol -->
  <path d="M322 235 L357 270 L322 305"
        fill="none" stroke="url(#code)"
        stroke-width="17" stroke-linecap="round"
        stroke-linejoin="round"/>

  <!-- Slash -->
  <path d="M282 220 L230 320"
        fill="none" stroke="#2563EB"
        stroke-width="15" stroke-linecap="round"/>

  <!-- Top Highlight -->
  <path d="M220 115 H292"
        stroke="#38D9FF" stroke-width="10"
        stroke-linecap="round" opacity=".9"/>

  <circle cx="256" cy="115" r="7" fill="#FFFFFF"/>
</svg>
